# このファイルは「どんな設定が必要か」を示す見本です。値は書きません。
# 使うときは、このファイルをコピーして .env という名前にし、そちらに本物の値を書きます。
# .env は .gitignore で除外されているので、GitHub には上がりません。

# --- Supabase（Phase 1〜） ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# サーバー側だけで使う強い権限のキー。画面側のコードには絶対に入れない
SUPABASE_SERVICE_ROLE_KEY=

# --- AI API（Phase 2〜） ---
# Edge Function をローカルで動かすときは、supabase/functions/.env に書く
GEMINI_API_KEY=

# --- Google Cloud（Phase 4〜） ---
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1

# --- AWS（Phase 5〜） ---
AWS_REGION=ap-northeast-1
